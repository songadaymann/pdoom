{
  "name": "pdoom-playtest",
  "account_id": "a79a1faef6e8f94566f3320429d54006",
  "main": "worker.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../output/playtest/assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/dev-config.json", "/platform/config.json", "/local/intro/*", "/music/*"]
  },
  "d1_databases": [{
    "binding": "SCORES",
    "database_name": "pdoom-playtest-scores",
    "database_id": "c6c7b6ae-ebed-40cc-9c2c-a9de34e42aa4"
  }],
  "observability": {"enabled": true}
}
