        if (site == 2) return (-1216, -2400);
        if (site == 3) return (1216, -2016);
        if (site == 4) return (352, -1408);
        return (0, 0);
    }
    static bool SiteInside(int site, Vector2 p) {
        if (site == 0) return p.X > -240 && p.X < -64 && p.Y > -128 && p.Y < 64;
        if (site == 1) return p.X > -1792 && p.X < -1280 && p.Y > 0 && p.Y < 448;
        if (site == 2) return p.X > -1376 && p.X < -1248 && p.Y > -2720 && p.Y < -2592;
        if (site == 3) return p.X > 1144 && p.X < 1664 && p.Y > -2368 && p.Y < -2112;
        if (site == 4) return p.X > 416 && p.X < 928 && p.Y > -1472 && p.Y < -1344;
        return false;
    }
