    static int SiteDoor(int site) {
        if (site == 0) return 0;
        if (site == 1) return 0;
        if (site == 2) return 0;
        if (site == 3) return 7077;
        if (site == 4) return 0;
        return 0;
    }
    static String SiteName(int site) {
        if (site == 0) return "Zvi Mowshowitz";
        if (site == 1) return "Victoria Krakovna";
        if (site == 2) return "Max Tegmark";
        if (site == 3) return "Paul Christiano";
        if (site == 4) return "Ajeya Cotra";
        return "";
    }
    static Vector2 SiteExit(int site) {
        if (site == 0) return (688, 1904);
        if (site == 1) return (480, 704);
        if (site == 2) return (864, 800);
        if (site == 3) return (1696, -224);
        if (site == 4) return (3296, -288);
        return (0, 0);
    }
    static bool SiteInside(int site, Vector2 p) {
        if (site == 0) return p.X > 640 && p.X < 724 && p.Y > 1940 && p.Y < 1978;
        if (site == 1) return p.X > 432 && p.X < 528 && p.Y > 560 && p.Y < 656;
        if (site == 2) return p.X > 832 && p.X < 1280 && p.Y > 768 && p.Y < 1040;
        if (site == 3) return p.X > 1728 && p.X < 1792 && p.Y > -256 && p.Y < -192;
        if (site == 4) return p.X > 3264 && p.X < 3328 && p.Y > -416 && p.Y < -352;
        return false;
    }
