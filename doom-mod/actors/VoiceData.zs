// Generated by scripts/import-voice-lines.py from the recorded takes in doom-web/voice/.
// Tics(key) is a take's length, so the subtitle stays up while it plays. 0 = not recorded.
// Said(key) is what the take says (lines.json), shown instead of the scripted text. "" = not recorded.
class PDVoiceData
{
    static int Tics(String key)
    {
        int t;
        t = Tics0(key); if (t) return t;
        t = Tics1(key); if (t) return t;
        t = Tics2(key); if (t) return t;
        return 0;
    }
    static String Said(String key)
    {
        String s;
        s = Said0(key); if (s != "") return s;
        s = Said1(key); if (s != "") return s;
        s = Said2(key); if (s != "") return s;
        return "";
    }
