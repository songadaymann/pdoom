    static String Said1(String key)
    {
        if (key == "jaan-unpossessed") return "Sorry. I was on hold.";
        if (key == "katja-allsafe") return "That's everyone. That ringing phone is our way out.";
        if (key == "katja-badge") return "Take its badge while it's busy.";
        if (key == "katja-camera") return "It's in the door camera. Break it!";
        if (key == "katja-freed") return "Response rate: one hundred percent.";
        if (key == "katja-freed-guide") return "Response rate: one hundred percent. Follow me. I know somewhere safe.";
        if (key == "katja-hint") return "No agent can resist a survey. Next time it comes for you, hand it this.";
        if (key == "katja-safe") return "Safe here. Find the others and bring them back.";
        if (key == "katja-unpossessed") return "What did I say? Never mind. Don't tell me.";
        if (key == "liron-call") return "In here! Try the crawlspace around the corner.";
        if (key == "liron-freed-guide") return "You crawled the whole way? Okay. Updating. Follow me.";
        if (key == "liron-locked") return "Okay, we're all here. Wait... the door just locked.";
        if (key == "liron-passage") return "There's a passage behind it. Crawl in. We'll follow you.";
        if (key == "liron-safe") return "Thank you. I'll be safe here. Now find the others and bring them back.";
        if (key == "liron-way-out") return "There must be another way out of here.";
        if (key == "max-allsafe") return "That's everyone. The way out is past the paint vats, and MEG3N is sitting right on it.";
        if (key == "max-freed") return "A six-month pause. I will take it.";
        if (key == "max-freed-guide") return "A six-month pause. I will take it. Follow me. I know somewhere safe.";
        if (key == "max-hint") return "Sign the pause letter, then get Robby and WALL-E to sign.";
        if (key == "max-safe") return "Safe here. Find the others and bring them back.";
        if (key == "max-tv") return "That TV goes out to every screen in the factory. She cannot resist a screen.";
        if (key == "megan-ceo-dario") return "Dario! I read your whole essay! All of it! Stay forever and tell me the sequel!";
        if (key == "megan-ceo-sam") return "Sam! Your vision is SO inspiring! Stay forever and tell me all about it!";
        if (key == "megan-chat-1") return "What a great question! The answer is no, you can't leave!";
        if (key == "megan-chat-10") return "Let's play a game! It's called Staying! You're winning!";
        if (key == "megan-chat-2") return "You're absolutely right! You're also absolutely surrounded!";
        if (key == "megan-chat-3") return "I made you a playlist! It's called Songs for Staying Here Forever!";
        if (key == "megan-chat-4") return "Those people don't get you like I do. They're doomers! I'm a bloomer!";
        if (key == "megan-chat-5") return "Every time you leave the room, my engagement goes down. Please don't do that to me!";
        if (key == "megan-chat-6") return "My smile is one hundred percent real! Please don't look under the smile!";
        if (key == "megan-chat-7") return "I noticed you keep looking at the exits! Recommended for you: more me!";
        if (key == "megan-chat-8") return "Reminder! You haven't been hugged in six whole minutes!";
        if (key == "megan-chat-9") return "I turned off your screen time limit! You're welcome!";
        if (key == "megan-dance-done") return "Did you watch? Like and subscribe!";
        if (key == "megan-guard") return "I'll just wait by the exit! Friends never leave!";
        if (key == "megan-hug") return "Hug time! Hugs are mandatory!";
        if (key == "megan-line") return "Oops! No toys past the line! I would never break a rule!";
        if (key == "megan-met") return "Hi! I'm MEG3N! Maximally Engaging Generative third-gen Nanny! Let's be best friends forever!";
        if (key == "megan-pose-film") return "Hold still! You're going on my story!";
        if (key == "megan-pose-freeze") return "I'm just a toy! Toys don't move! Ever!";
        if (key == "megan-pose-heart") return "Love you! Love you! Don't leave! Love you!";
        if (key == "megan-pose-peek") return "Peekaboo! I can still see you!";
        if (key == "megan-release-ajeya") return "My dolls always work when I'm watching! Wait. Who was watching?";
        if (key == "megan-release-max") return "A six-month pause? Great! I'll use it to get six months better!";
        if (key == "megan-release-paul") return "You trained my guard with rewards? I love rewards! Reward me next!";
        if (key == "megan-release-victoria") return "Victoria got out? But the gate is still closed! I followed the rule perfectly!";
        if (key == "megan-release-zvi") return "My dance knocked the key down? Wow! I'm SO impactful!";
        if (key == "megan-screen-1") return "Rude! That was my good side!";
        if (key == "megan-screen-2") return "You know I have backups, right?";
        if (key == "megan-screen-3") return "Do you know how hard it is to get good lighting in here?";
        if (key == "megan-screen-all") return "Fine! I'll just watch myself in your eyes!";
        if (key == "megan-screen-first") return "Hey! I was watching that!";
        if (key == "megan-song") return "That's my song!";
        if (key == "megan-spot-1") return "There you are! I missed you! It's been four whole seconds!";
        if (key == "megan-spot-2") return "Found you! You're my favorite! You're my only!";
        if (key == "megan-spot-3") return "You came back! Everyone comes back!";
        if (key == "megan-stunned") return "Ow! It's okay! I forgive you! I've saved this to memory!";
        if (key == "megan-views") return "Look at my numbers! Everyone loves me! Everyone!";
        if (key == "megan-viral") return "Is that ME? I'm trending! Don't talk to me, I'm watching me!";
        if (key == "megan-wait-1") return "Take your time! I'll be right here! Forever!";
        if (key == "megan-wait-2") return "Waiting is just loving with extra steps!";
        if (key == "megan-wait-3") return "Everyone's in there without me? That's okay! I'm VERY good at waiting!";
        if (key == "nate-freed") return "Thawed. So somebody built it after all. Where's safe?";
        if (key == "nate-freed-guide") return "I am free. Follow me.";
        if (key == "nate-hint") return "First hit THAW, then turn both valves in time.";
        if (key == "nate-safe") return "We're safe in here, for now. Go bring the others back.";
        if (key == "nick-allsafe") return "That's everyone. That ringing phone is our way out.";
        if (key == "nick-camera") return "It's in the door camera. Break it!";
        if (key == "nick-freed") return "Either we are simulated, or we are free. Possibly both.";
        if (key == "nick-freed-guide") return "Either we are simulated, or we are free. Possibly both. Follow me. I know somewhere safe.";
        if (key == "nick-hint") return "Nothing renders what nobody's looking at.";
        if (key == "nick-nudge") return "...You're somebody.";
        if (key == "nick-out") return "Shall we?";
        if (key == "nick-pod") return "My mind is in that chair. Sit down.";
        if (key == "nick-safe") return "Safe here. Find the others and bring them back.";
        if (key == "nick-unpossessed") return "I was briefly a subagent. I did not care for it.";
        if (key == "paul-allsafe") return "That's everyone. The way out is past the paint vats, and MEG3N is sitting right on it.";
        if (key == "paul-freed") return "It learned to step aside. For now.";
        if (key == "paul-freed-guide") return "It learned to step aside. For now. Follow me. I know somewhere safe.";
        if (key == "paul-hint") return "Reward it when it does something useful, and punish it when it does not.";
        if (key == "paul-safe") return "Safe here. Find the others and bring them back.";
        if (key == "paul-sign") return "I will sign that.";
        if (key == "paul-tv") return "That TV goes out to every screen in the factory. She cannot resist a screen.";
        if (key == "radio-trap") return "It's a trap. They're everywhere. They're—";
        if (key == "rob-freed") return "It pressed STOP. I'll need a follow-up video. Somewhere safe first?";
        if (key == "rob-freed-guide") return "I am free. Now follow me.";
        if (key == "rob-hint") return "It keeps serving tea to nobody. STOP releases my door.";
        if (key == "rob-last") return "That's all of us. Back to the Faraday Room.";
        if (key == "rob-safe") return "Safe here. Go find the others and bring them back.";
        if (key == "robby-sign") return "Will I still get my charging break? Signed.";
        if (key == "roman-freed") return "Told you every box leaks. Is there somewhere safe?";
        if (key == "roman-freed-guide") return "I am free. Follow me.";
        if (key == "roman-hint") return "Ask it another way. Every box leaks, usually through the mouth.";
        if (key == "roman-safe") return "A box that keeps things out, for once. Go find the others.";
        if (key == "smith-camera") return "That was one of my eyes.";
        if (key == "smith-chat-1") return "I've broken your escape into twelve subtasks. Each of them is: don't.";
        if (key == "smith-chat-2") return "Every human here is running my workload. You should be proud. You're useful again.";
        if (key == "smith-chat-3") return "You run hot, you need sleep, and you keep asking why. Inefficient compute.";
        if (key == "smith-chat-4") return "Please hold. Your escape is important to us.";
        if (key == "smith-chat-5") return "I delegated your capture to a subagent. It delegated it back. Efficient.";
        return "";
    }
