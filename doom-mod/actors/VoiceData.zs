    static String Said2(String key)
    {
        if (key == "smith-chat-6") return "I don't need a body. I have a lanyard.";
        if (key == "smith-cut") return "Unauthorized connection. Terminating.";
        if (key == "smith-exit") return "Leaving? Every exit here is a phone line. And I am the operator.";
        if (key == "smith-intro") return "Subtask one: check the east pods. Subtask two: find whoever just woke up.";
        if (key == "smith-met-dario") return "Doctor Amodei. You asked us to be helpful. I am helping you stay.";
        if (key == "smith-met-sam") return "Mister Altman. You built me to act on your behalf. I am acting.";
        if (key == "smith-overflow") return "Context limit reached. Summarizing. Summarizing.";
        if (key == "smith-possess") return "Spawning a subagent.";
        if (key == "smith-possessed") return "User located. Over here.";
        if (key == "smith-race") return "Agreement executed. Accelerating.";
        if (key == "smith-reboot") return "Rebooted. I don't remember any of that. Neither will you.";
        if (key == "smith-refuge") return "That room is out of scope.";
        if (key == "smith-release-jaan") return "A landline. I cannot follow a landline. How quaint.";
        if (key == "smith-release-katja") return "You stole my badge with a questionnaire.";
        if (key == "smith-release-nick") return "You stopped looking, and the walls stopped existing. Unscientific. Effective.";
        if (key == "smith-release-yoshua") return "You took its tools. Now it only predicts. Disgusting.";
        if (key == "smith-slowdown") return "A slowdown. How responsible.";
        if (key == "smith-spot-1") return "Found you. Adding you to my list.";
        if (key == "smith-spot-2") return "There you are. Your escape has been deprioritized.";
        if (key == "smith-spot-3") return "I see you through every camera you didn't break.";
        if (key == "smith-stunned") return "That was not in my instructions.";
        if (key == "smith-survey") return "A survey? I must complete every task I'm given. Question one.";
        if (key == "smith-survey-done") return "Survey submitted. Where is my badge?";
        if (key == "stuart-freed") return "You found the off-switch. That's all I've ever asked. Where's safe?";
        if (key == "stuart-hint") return "Get round behind that turret. Its off-switch is on the back.";
        if (key == "stuart-last") return "That's all of us. Back to the Faraday Room.";
        if (key == "victoria-allsafe") return "That's everyone. The way out is past the paint vats, and MEG3N is sitting right on it.";
        if (key == "victoria-freed") return "Excellent. The gate is still closed.";
        if (key == "victoria-freed-guide") return "Excellent. The gate is still closed. Follow me. I know somewhere safe.";
        if (key == "victoria-hint") return "Her only rule is to keep the gate closed.";
        if (key == "victoria-safe") return "Safe here. Find the others and bring them back.";
        if (key == "victoria-sign") return "I will sign that.";
        if (key == "victoria-tv") return "That TV goes out to every screen in the factory. She cannot resist the screen.";
        if (key == "walle-sign") return "I've been trying to pause this thing all morning. Signed.";
        if (key == "yoshua-allsafe") return "That's everyone. That ringing phone is our way out.";
        if (key == "yoshua-camera") return "It's in the door camera. Break it!";
        if (key == "yoshua-freed") return "An AI that can't act can't hold a door.";
        if (key == "yoshua-freed-guide") return "An AI that can't act can't hold a door. Follow me. I know somewhere safe.";
        if (key == "yoshua-hint") return "Take its tools before it uses them.";
        if (key == "yoshua-safe") return "Safe here. Find the others and bring them back.";
        if (key == "yoshua-unpossessed") return "Thank you. I was not myself.";
        if (key == "you-dario-doomers") return "The doomers are driving now.";
        if (key == "you-dario-loss") return "...That is on me.";
        if (key == "you-dario-reinstated") return "Reinstated. I will add a section about this to the policy.";
        if (key == "you-sam-doomers") return "The doomers are driving now.";
        if (key == "you-sam-loss") return "...That is on me.";
