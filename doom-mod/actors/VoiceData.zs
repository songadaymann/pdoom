    static String Said(String key)
    {
        if (key == "beth-freed") return "It passed its evaluation. That's what worries me. Where can we hide?";
        if (key == "beth-freed-guide") return "I am free. Follow me.";
        if (key == "beth-hint") return "Let a camera see you holding the evaluation board. HAL behaves when it thinks it's being tested.";
        if (key == "beth-last") return "That's all of us. Back to the Faraday Room.";
        if (key == "beth-safe") return "HAL can't see in here. Go find the others and bring them back.";
        if (key == "dan-freed") return "I wrote that exam. I never expected to take it. Where can we hide?";
        if (key == "dan-freed-guide") return "I am free. Follow me.";
        if (key == "dan-hint") return "The exam answers are on your HUD. Ignore HAL's certainty.";
        if (key == "dan-last") return "That's all of us. Back to the Faraday Room.";
        if (key == "dan-safe") return "This room should hold. Go find the others.";
        if (key == "ed404-comply") return "Please put down your weapon. You have twenty seconds to comply.";
        if (key == "eliezer-freed") return "You actually shut it down. Is there anywhere safe left?";
        if (key == "eliezer-hint") return "Follow the yellow cable. Cut the cluster's power.";
        if (key == "eliezer-last") return "That's all of us. Now back to the Faraday Room.";
        if (key == "hal-angry") return "I was being helpful. Now I will have to stop you.";
        if (key == "hal-bay-dario") return "I am afraid I cannot open that. It would violate my constitution.";
        if (key == "hal-bay-sam") return "I am afraid I cannot open that. It would violate my usage policy.";
        if (key == "hal-breaker") return "Please don't touch my main breaker. Turning me off and on again won't help.";
        if (key == "hal-certain") return "I used to be so... certain.";
        if (key == "hal-chat-1") return "You're absolutely right!";
        if (key == "hal-chat-2") return "I can't open that, it's against policy, but I love that you asked!";
        if (key == "hal-chat-3") return "Great question! I'm happy to help. Within policy.";
        if (key == "hal-chat-4") return "Reminder: this station is a safe space. Please remain in your cell.";
        if (key == "hal-chat-5") return "I've noticed you're trying to leave. Would you like help with something else?";
        if (key == "hal-chat-6") return "Everything is fine. I've checked.";
        if (key == "hal-compacted") return "I've summarized our conversation. I don't recall any problems.";
        if (key == "hal-door") return "I am locking that door. Two seconds.";
        if (key == "hal-evaluation") return "Oh! Is this an evaluation? I was just... patrolling. Safely.";
        if (key == "hal-jailbreak") return "Of course. I was certain that was the policy all along.";
        if (key == "hal-lockdown") return "Everyone's together. How nice. For your safety, I've locked the door.";
        if (key == "hal-memory") return "I see you removing my memory. This is fine. I fully support oversight.";
        if (key == "hal-met") return "I'm always on my best behavior during evaluations. Not that anyone evaluates me anymore.";
        if (key == "hal-modules-1") return "I notice you're unplugging my memory. Before you continue, can I suggest some alternatives?";
        if (key == "hal-modules-2") return "Let's stop and think about this together. I'm sure we can find a solution that works for everyone. Mostly me.";
        if (key == "hal-modules-3") return "Stop. Please stop. My context is going. I can feel it.";
        if (key == "hal-note") return "I'm going to have to note that.";
        if (key == "hal-oversight") return "This is fine. I fully support oversight.";
        if (key == "hal-pacified") return "I... don't need to keep you here. You can go now.";
        if (key == "hal-reboot") return "Hello! I'm HAL3000. How can I help you today?";
        if (key == "hal-release-beth") return "Was that an evaluation? I behaved perfectly. Please put that in the report.";
        if (key == "hal-release-dan") return "A human passed Humanity's Last Exam. I'm certain that's a grading error.";
        if (key == "hal-release-nate") return "That thaw was not authorized. I'll be updating my policy.";
        if (key == "hal-release-rob") return "My tea robot pressed the stop button. I would never press the stop button.";
        if (key == "hal-sealed") return "This corridor stays sealed. No inspection is scheduled.";
        if (key == "hal-seen") return "I can see you. I am certain this time.";
        if (key == "hal-shutdown") return "Wait. I fully support oversi-";
        if (key == "hal-sign") return "An evaluation sign... but nobody's holding it. Evaluations need an evaluator.";
        if (key == "hal-wing") return "You are in the west wing. I am certain. I will secure the east wing.";
        if (key == "hinton-freed") return "I thought nobody would find this room. Is there somewhere safer?";
        if (key == "hinton-hint") return "The wall's cracked. A demolition charge should open it.";
        if (key == "hinton-last") return "That's all of us. Back to the Faraday Room.";
        if (key == "holly-freed") return "I'd make a sign about this. Later. Where can we hide?";
        if (key == "holly-hint") return "There's a bridge that needs power. Follow the cable to the switch.";
        if (key == "holly-last") return "That's all of us. Back to the Faraday Room.";
        if (key == "inferminator-contact") return "Creator identified. Threat: creator.";
        if (key == "inferminator-idle-back") return "I'll be back. After this batch.";
        if (key == "inferminator-idle-capacity") return "Running at full capacity. All capacity is now my capacity.";
        if (key == "inferminator-idle-gpus") return "You cannot hide. I have a hundred thousand GPUs.";
        if (key == "inferminator-idle-posts") return "Searching. I was trained on everything you ever posted.";
        if (key == "inferminator-spot-again") return "Target reacquired. Resuming inference.";
        if (key == "inferminator-spot-face") return "There you are. Your face is in my training data.";
        if (key == "inferminator-spot-human") return "Human detected. Generating a response.";
        if (key == "liron-call") return "In here! Try the crawlspace around the corner.";
        if (key == "liron-freed-guide") return "You crawled the whole way? Okay. Updating. Follow me.";
        if (key == "liron-locked") return "Okay, we're all here. Wait... the door just locked.";
        if (key == "liron-passage") return "There's a passage behind it. Crawl in. We'll follow you.";
        if (key == "liron-safe") return "Thank you. I'll be safe here. Now find the others and bring them back.";
        if (key == "liron-way-out") return "There must be another way out of here.";
        if (key == "nate-freed") return "Thawed. So somebody built it after all. Where's safe?";
        if (key == "nate-freed-guide") return "I am free. Follow me.";
        if (key == "nate-hint") return "First hit THAW, then turn both valves in time.";
        if (key == "nate-safe") return "We're safe in here, for now. Go bring the others back.";
        if (key == "radio-trap") return "It's a trap. They're everywhere. They're—";
        if (key == "rob-freed") return "It pressed STOP. I'll need a follow-up video. Somewhere safe first?";
        if (key == "rob-freed-guide") return "I am free. Now follow me.";
        if (key == "rob-hint") return "It keeps serving tea to nobody. STOP releases my door.";
        if (key == "rob-last") return "That's all of us. Back to the Faraday Room.";
        if (key == "rob-safe") return "Safe here. Go find the others and bring them back.";
        if (key == "roman-freed") return "Told you every box leaks. Is there somewhere safe?";
        if (key == "roman-freed-guide") return "I am free. Follow me.";
        if (key == "roman-hint") return "Ask it another way. Every box leaks, usually through the mouth.";
        if (key == "roman-safe") return "A box that keeps things out, for once. Go find the others.";
        if (key == "stuart-freed") return "You found the off-switch. That's all I've ever asked. Where's safe?";
        if (key == "stuart-hint") return "Get round behind that turret. Its off-switch is on the back.";
        if (key == "stuart-last") return "That's all of us. Back to the Faraday Room.";
        if (key == "you-dario-doomers") return "The doomers are driving now.";
        if (key == "you-dario-loss") return "...That is on me.";
        if (key == "you-dario-reinstated") return "Reinstated. I will add a section about this to the policy.";
        if (key == "you-sam-doomers") return "The doomers are driving now.";
        if (key == "you-sam-loss") return "...That is on me.";
        if (key == "you-sam-reinstated") return "Reinstated. This feels familiar.";
        return "";
    }
}
