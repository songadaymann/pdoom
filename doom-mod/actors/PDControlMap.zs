    static int SiteDoor(int site) {
        if (site == 0) return 876;
        if (site == 1) return 878;
        if (site == 2) return 879;
        if (site == 3) return 880;
        if (site == 4) return 881;
        return 0;
    }
    static String SiteName(int site) {
        if (site == 0) return "Liron Shapira";
        if (site == 1) return "Stuart Russell";
        if (site == 2) return "Eliezer Yudkowsky";
        if (site == 3) return "Geoffrey Hinton";
        if (site == 4) return "Holly Elmore";
        return "";
    }
    static Vector2 SiteExit(int site) {
        if (site == 0) return (1930, 1180);
        if (site == 1) return (-112, 1984);
        if (site == 2) return (-752, -288);
        if (site == 3) return (-1424, 1120);
        if (site == 4) return (-1376, 1888);
        return (0, 0);
    }
    static bool SiteInside(int site, Vector2 p) {
        if (site == 0) return p.X > 1872 && p.X < 1984 && p.Y > 896 && p.Y < 1108;
        if (site == 1) return p.X > -192 && p.X < -32 && p.Y > 2048 && p.Y < 2192;
        if (site == 2) return p.X > -1000 && p.X < -824 && p.Y > -352 && p.Y < -224;
        if (site == 3) return p.X > -1696 && p.X < -1472 && p.Y > 1040 && p.Y < 1200;
        if (site == 4) return p.X > -1600 && p.X < -1456 && p.Y > 1824 && p.Y < 1952;
        return false;
    }
