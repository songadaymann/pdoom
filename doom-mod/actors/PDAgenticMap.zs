        if (tag == 8139) { at = (708.0, 1788.0); if ((at-near).Length() < distance) { best=at; distance=(at-near).Length(); } }
        if (tag == 8141) { at = (1044.0, 1464.0); if ((at-near).Length() < distance) { best=at; distance=(at-near).Length(); } }
        if (tag == 8143) { at = (1184.0, 1660.0); if ((at-near).Length() < distance) { best=at; distance=(at-near).Length(); } }
        if (tag == 8144) { at = (908.0, 1756.0); if ((at-near).Length() < distance) { best=at; distance=(at-near).Length(); } }
        if (tag == 8211) { at = (2352.0, 1900.0); if ((at-near).Length() < distance) { best=at; distance=(at-near).Length(); } }
        if (tag == 8215) { at = (2516.0, 2016.0); if ((at-near).Length() < distance) { best=at; distance=(at-near).Length(); } }
        return best; }
    static Vector2 Center(int node) { int row = node / Width(); return (OriginX() + (node % Width() + 0.5) * Step(), OriginY() + (row + 0.5) * Step()); }
