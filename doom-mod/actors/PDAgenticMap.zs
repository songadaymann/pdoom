    static int SiteDoor(int site) {
        if (site == 0) return 7420;
        if (site == 1) return 0;
        if (site == 2) return 7430;
        if (site == 3) return 7460;
        if (site == 4) return 7450;
        return 0;
    }
    static String SiteName(int site) {
        if (site == 0) return "Jaan Tallinn";
        if (site == 1) return "Nick Bostrom";
        if (site == 2) return "Daniel Kokotajlo";
        if (site == 3) return "Katja Grace";
        if (site == 4) return "Yoshua Bengio";
        return "";
    }
    static Vector2 SiteExit(int site) {
        if (site == 0) return (32, 496);
        if (site == 1) return (288, 1152);
        if (site == 2) return (880, -160);
        if (site == 3) return (1800, 1104);
        if (site == 4) return (1952, 472);
        return (0, 0);
    }
    static bool SiteInside(int site, Vector2 p) {
        if (site == 0) return p.X > -48 && p.X < 120 && p.Y > 584 && p.Y < 752;
        if (site == 1) return p.X > 384 && p.X < 448 && p.Y > 1152 && p.Y < 1280;
        if (site == 2) return p.X > 820 && p.X < 884 && p.Y > -240 && p.Y < -184;
        if (site == 3) return p.X > 1728 && p.X < 1792 && p.Y > 1472 && p.Y < 1536;
        if (site == 4) return p.X > 2176 && p.X < 2272 && p.Y > 368 && p.Y < 576;
        return false;
    }
    static Vector2 DoorPoint(int tag, Vector2 near) { Vector2 best = near; double distance = 999999; Vector2 at;
        if (tag == 8006) { at = (128.0, -472.0); if ((at-near).Length() < distance) { best=at; distance=(at-near).Length(); } }
        if (tag == 8011) { at = (-200.0, -96.0); if ((at-near).Length() < distance) { best=at; distance=(at-near).Length(); } }
